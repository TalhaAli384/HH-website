// HH Constructions and Developers — database schema
// Connection URL is configured in prisma.config.ts (DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ──────────────────────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  blogPosts BlogPost[]
}

// A customer/lead. Created or matched by email whenever a public form is submitted,
// so every inquiry from the same person is grouped together.
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contactMessages ContactMessage[]
  quoteRequests   QuoteRequest[]
}

// ─── Portfolio ─────────────────────────────────────────────────────────

enum ProjectStatus {
  COMPLETED
  ONGOING
  UPCOMING
}

enum ProjectCategory {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  INTERIOR
  INFRASTRUCTURE
  REAL_ESTATE
}

model Project {
  id               String          @id @default(cuid())
  title            String
  slug             String          @unique
  summary          String
  description      String
  category         ProjectCategory
  status           ProjectStatus   @default(ONGOING)
  location         String
  client           String?
  area             String?
  floors           Int?
  budget           String?
  startDate        DateTime?
  completionDate   DateTime?
  coverImage       String
  coverImageId     String?
  // Free-form specification rows, e.g. [{ "label": "Structure", "value": "RCC frame" }]
  specifications   Json            @default("[]")
  featured         Boolean         @default(false)
  published        Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  images ProjectImage[]

  @@index([status])
  @@index([category])
  @@index([featured, published])
}

model ProjectImage {
  id        String   @id @default(cuid())
  url       String
  publicId  String?
  caption   String?
  sortOrder Int      @default(0)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String
  description String
  icon        String   @default("Building2")
  image       String
  imageId     String?
  features    String[]
  sortOrder   Int      @default(0)
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── People ────────────────────────────────────────────────────────────

enum TeamDepartment {
  MANAGEMENT
  ARCHITECTURE
  ENGINEERING
  PROJECT_MANAGEMENT
  TECHNICAL
}

model TeamMember {
  id         String         @id @default(cuid())
  name       String
  position   String
  department TeamDepartment
  bio        String?
  photo      String
  photoId    String?
  email      String?
  linkedin   String?
  sortOrder  Int            @default(0)
  published  Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  company   String?
  content   String
  rating    Int      @default(5)
  photo     String?
  photoId   String?
  featured  Boolean  @default(true)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Inquiries ─────────────────────────────────────────────────────────

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  message   String
  status    InquiryStatus @default(NEW)
  notes     String?
  ipAddress String?
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model QuoteRequest {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String
  projectType String
  location    String
  budget      String
  projectSize String
  description String
  status      InquiryStatus @default(NEW)
  notes       String?
  ipAddress   String?
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ─── Blog ──────────────────────────────────────────────────────────────

model BlogCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  createdAt   DateTime   @default(now())

  posts BlogPost[]
}

model BlogPost {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String
  content       String
  coverImage    String
  coverImageId  String?
  published     Boolean       @default(false)
  publishedAt   DateTime?
  readMinutes   Int           @default(4)
  categoryId    String?
  category      BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId      String?
  author        Admin?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([published, publishedAt])
}

// ─── Site content ──────────────────────────────────────────────────────

// Key/value store for editable company information and page copy.
// Values are JSON so a key can hold a string, number or structured block.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
