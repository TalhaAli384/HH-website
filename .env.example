# ── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hh_constructions"
# Max connections per server instance (use 1–3 on serverless hosts like Vercel)
DATABASE_POOL_SIZE="10"

# ── Site ────────────────────────────────────────────────────
# Public URL used for SEO metadata, sitemap and Open Graph tags
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Authentication ──────────────────────────────────────────
# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# Initial admin account created by `npm run db:seed`
SEED_ADMIN_NAME="Site Administrator"
SEED_ADMIN_EMAIL="admin@hhconstructions.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"

# ── Cloudinary (image uploads) ──────────────────────────────
# If left empty, uploads are stored in /public/uploads (development only).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="hh-constructions"

# ── Email notifications (SMTP) ──────────────────────────────
# If SMTP_HOST is empty, notifications are logged to the console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="HH Constructions <no-reply@hhconstructions.com>"
# Where new inquiry notifications are sent
NOTIFY_EMAIL="info@hhconstructions.com"

# ── Google Maps ─────────────────────────────────────────────
# Optional. Without a key the contact page uses the keyless embed.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
